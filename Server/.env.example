# Server
NODE_ENV=development
PORT=4000

# Required
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
DATABASE_URL=postgresql://postgres:password@localhost:5432/oriyon

# Or individual PG settings instead of DATABASE_URL
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=oriyon
# PGUSER=postgres
# PGPASSWORD=password

# Frontend / CORS
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_MODERATION=

# Phone OTP / SMS
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Never set to true in production
SMS_EXPOSE_CODE=false

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Payments — Alif (optional)
ALIF_ENABLED=false
ALIF_TERMINAL_KEY=
ALIF_TERMINAL_PASSWORD=
ALIF_API_URL=
ALIF_GATE=
ALIF_CALLBACK_URL=
ALIF_RETURN_URL=

# Maintenance
LISTING_MAINTENANCE_INTERVAL_MS=3600000
MODERATION_TRUSTED_THRESHOLD=8
